{
  "name": "vibeforge",
  "productName": "Vibeforge",
  "description": "AI-assisted ad design pipeline node for O-Kay-Est Media — receives ad jobs from Unity Core, generates creative across platform formats, delivers to OKLaunch",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist-electron/main/main.js",
  "author": "O-Kay-Est Media LLC",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && tsc -p electron/tsconfig.build.json && node scripts/stamp-cjs.cjs && vite build",
    "preview": "vite preview",
    "electron:dev": "npm run build && electron .",
    "package": "npm run build && electron-builder"
  },
  "dependencies": {
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^6.28.0",
    "zustand": "^5.0.2",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@types/node": "^22.10.1",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  },
  "build": {
    "appId": "com.okayestmedia.vibeforge",
    "productName": "Vibeforge",
    "files": ["dist/**/*", "dist-electron/**/*"],
    "win": { "target": "nsis", "icon": "resources/icons/icon.ico" },
    "mac": { "target": "dmg", "icon": "resources/icons/icon.icns" },
    "linux": { "target": "AppImage", "icon": "resources/icons/icon.png" }
  }
}
